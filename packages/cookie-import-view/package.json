{
  "name": "@lvce-editor/cookie-import-view",
  "version": "0.0.0-dev",
  "description": "Firefox cookie import view worker for LVCE Editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/cookie-import-view.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/cookieImportViewWorkerMain.ts",
  "scripts": {
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/test/**"
    ],
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@lvce-editor/constants": "^5.29.0",
    "@lvce-editor/i18n": "^2.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@lvce-editor/rpc": "^6.19.3",
    "@lvce-editor/rpc-registry": "^9.55.0",
    "@lvce-editor/viewlet-registry": "^5.12.0",
    "@lvce-editor/virtual-dom-worker": "^11.16.2",
    "@types/node": "^22.20.1",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.12"
  }
}
